NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=your-university-email@university.edu

# Configure these to email verification codes. Leave unset for local demo mode.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Local demo only: print the verification code in the API response and terminal.
# Never enable this in production.
ALLOW_DEV_EMAIL_CODE=true
